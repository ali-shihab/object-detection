# This repository contains ONLY what the coursework brief asks for: the deliverable folder
# project_18006111_Shihab/ (src, tools, configs, tests, smartphone_dataset, results) and a README.
# Working material that is not a deliverable is kept out.

# --- not deliverables ---
docs/
scripts/
report/
_scratch/
annotations.json

# --- supplied datasets: the brief forbids redistributing them, and they are GBs ---
data/
project_18006111_Shihab/results/artifacts/
project_18006111_Shihab/results/results/
project_18006111_Shihab/results/**/*.npz
*.7z
*.tar
*.tgz

# --- trained weights: shipped in the submission zip, not in git (2 x 40 MB binaries) ---
project_18006111_Shihab/weights/*.pt
project_18006111_Shihab/weights/*.pth

# --- raw phone footage is source material; the 60 annotated frames are the dataset ---
project_18006111_Shihab/smartphone_dataset/raw_videos/
project_18006111_Shihab/smartphone_dataset/qc/

# --- duplicates and cross-deliverable build artefacts ---
# results/logs/ is a byte-identical copy of results/runs/, which is the one the README documents.
project_18006111_Shihab/results/logs/
# The generated LaTeX tables belong to the report, not to results/.
project_18006111_Shihab/results/*.tex

